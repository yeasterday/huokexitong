<view class="login-page">
  <view class="hero-card">
    <view class="hero-top">
      <text class="hero-title">加入青源智盟</text>
      <text class="hero-subtitle">注册完成后会自动绑定当前微信，并直接进入你的学习空间</text>
    </view>
    <view class="hero-badges">
      <text class="hero-badge">自动绑定</text>
      <text class="hero-badge">积分奖励</text>
      <text class="hero-badge">专属校区</text>
    </view>
  </view>

  <view class="form-card">
    <view class="input-block">
      <text class="input-label">手机号账号</text>
      <input
        class="input-field"
        type="number"
        maxlength="11"
        placeholder="请输入 11 位手机号"
        value="{{account}}"
        data-field="account"
        bindinput="handleInput"
      />
    </view>

    <view class="input-block">
      <text class="input-label">你的昵称</text>
      <input
        class="input-field"
        placeholder="设置一个醒目的名字"
        value="{{nickname}}"
        data-field="nickname"
        bindinput="handleInput"
      />
    </view>

    <view class="input-block">
      <text class="input-label">登录密码</text>
      <input
        class="input-field"
        password="true"
        placeholder="不少于 8 位"
        value="{{password}}"
        data-field="password"
        bindinput="handleInput"
      />
    </view>

    <view class="input-block">
      <text class="input-label">机构邀请码</text>
      <input
        class="input-field"
        placeholder="选填，填写后可加入专属校区"
        value="{{inviteCode}}"
        data-field="inviteCode"
        bindinput="handleInput"
      />
    </view>

    <button class="submit-btn" loading="{{loading}}" bindtap="handleRegister">
      注册并进入学习空间
    </button>

    <view class="tips-box">
      <text>新用户默认赠送 100 积分，后续还可以通过签到、闯关、互动和资源兑换持续积累。</text>
    </view>
  </view>
</view>
