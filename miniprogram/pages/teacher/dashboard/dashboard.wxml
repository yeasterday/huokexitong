<view class="dashboard-container">
  <view class="header-card">
    <view class="org-info">
      <view class="org-name">{{institutionName}}</view>
      <view class="org-status">系统运行正常 🟢</view>
    </view>
    
    <view class="data-grid">
      <view class="data-item">
        <text class="data-num">{{newLeads}}</text>
        <text class="data-label">今日新线索</text>
      </view>
      <view class="data-item">
        <text class="data-num">{{todayCheckins}}</text>
        <text class="data-label">今日打卡</text>
      </view>
      <view class="data-item">
        <text class="data-num">{{totalStudents}}</text>
        <text class="data-label">在读学员</text>
      </view>
    </view>
  </view>

  <view class="module-box">
    <view class="module-title">教务督学中心</view>
    <view class="tool-grid">
      <view class="tool-item" bindtap="goToStudents">
        <view class="tool-icon bg-blue">👨‍🎓</view>
        <text class="tool-text">学员档案</text>
      </view>
      <view class="tool-item" bindtap="goToClasses">
        <view class="tool-icon bg-green">🏫</view>
        <text class="tool-text">班级管理</text>
      </view>
      <view class="tool-item" bindtap="comingSoon">
        <view class="tool-icon bg-orange">✅</view>
        <text class="tool-text">作业批改</text>
      </view>
      <view class="tool-item" bindtap="comingSoon">
        <view class="tool-icon bg-purple">📊</view>
        <text class="tool-text">学情报告</text>
      </view>
    </view>
  </view>

  <view class="module-box">
    <view class="module-title">招生裂变工具</view>
    <view class="tool-grid">
      <view class="tool-item highlight" bindtap="goToPosterConfig">
        <view class="tool-icon">📸</view>
        <text class="tool-text">战绩海报</text>
      </view>
      <view class="tool-item" bindtap="comingSoon">
        <view class="tool-icon bg-pink">🎁</view>
        <text class="tool-text">体验课引流</text>
      </view>
      <view class="tool-item" bindtap="comingSoon">
        <view class="tool-icon bg-yellow">积分</view>
        <text class="tool-text">积分商城</text>
      </view>
      <view class="tool-item" bindtap="comingSoon">
        <view class="tool-icon bg-gray">⚙️</view>
        <text class="tool-text">机构设置</text>
      </view>
    </view>
  </view>
</view>