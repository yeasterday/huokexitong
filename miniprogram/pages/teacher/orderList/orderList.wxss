page { background: #f4f7fc; }
.container { padding: 30rpx; }

.header { margin-bottom: 30rpx; display: flex; align-items: baseline; }
.title { font-size: 40rpx; font-weight: bold; color: #1a1b26; margin-right: 20rpx; }
.count { font-size: 26rpx; color: #673AB7; background: rgba(103,58,183,0.1); padding: 4rpx 16rpx; border-radius: 20rpx; }

/* 管理员卡片 */
.admin-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 10rpx 25rpx rgba(0,0,0,0.03);
}

.user-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 25rpx;
}
.user-name { font-size: 30rpx; font-weight: bold; color: #333; }

/* 发货按钮：亮紫色 */
.status-btn {
  background: linear-gradient(135deg, #673AB7, #9C27B0);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 30rpx;
  border-radius: 30rpx;
  font-weight: bold;
}

.item-row { margin-bottom: 20rpx; }
.item-title { font-size: 28rpx; color: #444; }

.address-row {
  background: #f8f9fb;
  padding: 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
}
.addr-content { font-size: 26rpx; color: #666; line-height: 1.4; display: block; }