<view class="container">
  <view class="header-tips">当前页展示的是本校区已发布资源，可用于统一审核和下架。</view>

  <view class="audit-list">
    <view class="audit-card" wx:for="{{resourceList}}" wx:key="_id">
      <view class="card-header">
        <text class="r-type">{{item.type}}</text>
        <text class="r-points">{{item.points}} 积分</text>
      </view>
      <view class="r-title">{{item.title}}</view>
      <view class="r-desc">{{item.content}}</view>

      <view class="card-footer">
        <text class="r-data">{{item.orgName || item.authorName || '当前校区'}}</text>
        <view class="delete-btn" bindtap="deleteResource" data-id="{{item._id}}">下架资源</view>
      </view>
    </view>

    <view class="empty-state" wx:if="{{resourceList.length === 0}}">
      当前校区还没有需要审核的资源。
    </view>
  </view>
</view>
