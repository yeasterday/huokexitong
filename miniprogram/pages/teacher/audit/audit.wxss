.container { min-height: 100vh; background: #f4f6f9; padding-bottom: 50rpx; }

.header-tips { background: #ffebee; color: #c62828; font-size: 24rpx; padding: 20rpx 30rpx; font-weight: bold; }

.audit-list { padding: 30rpx; }
.audit-card { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-bottom: 30rpx; box-shadow: 0 4rpx 15rpx rgba(0,0,0,0.05); border-left: 8rpx solid #1a1b26; }

.card-header { display: flex; justify-content: space-between; margin-bottom: 15rpx; }
.r-type { background: #e8eaf6; color: #3f51b5; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 6rpx; }
.r-points { color: #f57c00; font-size: 24rpx; font-weight: bold; }

.r-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 10rpx; }
.r-desc { font-size: 24rpx; color: #666; line-height: 1.5; margin-bottom: 20rpx; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

.card-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1rpx solid #eee; padding-top: 20rpx; }
.r-data { font-size: 22rpx; color: #999; }
.delete-btn { background: #c62828; color: #fff; font-size: 24rpx; padding: 10rpx 30rpx; border-radius: 30rpx; font-weight: bold; box-shadow: 0 4rpx 10rpx rgba(198,40,40,0.3); }

.empty-state { text-align: center; color: #999; font-size: 28rpx; margin-top: 100rpx; }