<view class="container">
  <view class="header">
    <text class="title">发布资源</text>
    <text class="desc">支持发布政策解读、精品视频、真题资料和招生素材，发布后会出现在学生端资料中心。</text>
  </view>

  <view class="form-box">
    <view class="input-item">
      <text class="label">资源标题</text>
      <input class="input" placeholder="例如：2026 中考英语政策解读" model:value="{{title}}" />
    </view>

    <view class="input-item">
      <text class="label">解锁积分</text>
      <input class="input" type="number" placeholder="可以填 0，表示免费领取" model:value="{{points}}" />
    </view>

    <view class="input-item">
      <text class="label">资源分类</text>
      <picker bindchange="onTypeChange" value="{{typeIndex}}" range="{{typeList}}">
        <view class="picker-box">{{typeList[typeIndex]}} ▾</view>
      </picker>
    </view>

    <view class="input-item">
      <text class="label">详细介绍</text>
      <textarea class="textarea" placeholder="补充内容亮点、适用人群、使用方式等" model:value="{{content}}" maxlength="500"></textarea>
    </view>

    <view class="input-item">
      <text class="label">提取链接或文件地址</text>
      <input class="input" placeholder="可填写网盘链接、云存储 fileID 或外部链接" model:value="{{link}}" />
    </view>
  </view>

  <button class="submit-btn" bindtap="submitResource">立即发布</button>
</view>
