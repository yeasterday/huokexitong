page { background: #f8f9fb; }
.container { padding: 40rpx; }
.header { margin-bottom: 50rpx; }
.title { font-size: 40rpx; font-weight: bold; color: #1a1b26; display: block; }
.desc { font-size: 24rpx; color: #999; margin-top: 10rpx; }

.form-box { background: #fff; border-radius: 24rpx; padding: 30rpx; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.02); }
.input-item { margin-bottom: 40rpx; }
.label { font-size: 28rpx; color: #333; font-weight: bold; display: block; margin-bottom: 15rpx; }
.input { height: 80rpx; background: #f4f6f9; border-radius: 12rpx; padding: 0 20rpx; font-size: 28rpx; }
.picker-box { height: 80rpx; background: #f4f6f9; border-radius: 12rpx; line-height: 80rpx; padding: 0 20rpx; font-size: 28rpx; color: #673AB7; }
.textarea { width: 100%; height: 200rpx; background: #f4f6f9; border-radius: 12rpx; padding: 20rpx; font-size: 28rpx; box-sizing: border-box; }

.submit-btn {
  margin-top: 60rpx;
  background: #1a1b26;
  color: #FFD54F;
  border-radius: 50rpx;
  font-weight: bold;
  height: 100rpx;
  line-height: 100rpx;
}