/* 页面底色与整体边距 */
.container { 
  padding: 30rpx; 
  background: #f4f7f9; 
  min-height: 100vh; 
  padding-bottom: 120rpx; /* 给底部按钮留出空间 */
}

/* 顶部标题区 */
.header { 
  margin-bottom: 40rpx; 
  padding: 0 10rpx; 
}
.title { 
  font-size: 40rpx; 
  font-weight: bold; 
  color: #333; 
  display: block; 
  margin-bottom: 10rpx; 
}
.subtitle { 
  font-size: 24rpx; 
  color: #999; 
}

/* 活动卡片样式 */
.promo-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.03); /* 高级感的微小阴影 */
}

/* 卡片第一行：标题与标签 */
.promo-info { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  margin-bottom: 15rpx; 
}
.promo-title { 
  font-size: 32rpx; 
  font-weight: bold; 
  color: #333; 
}
.promo-tag { 
  font-size: 20rpx; 
  background: #FFF3E0; 
  color: #FF9800; 
  padding: 4rpx 16rpx; 
  border-radius: 20rpx; 
}

/* 卡片内容描述 */
.promo-desc { 
  font-size: 26rpx; 
  color: #666; 
  margin-bottom: 30rpx; 
  line-height: 1.5; 
}

/* 卡片底部：数据与按钮 */
.promo-footer { 
  display: flex; 
  justify-content: space-between; 
  align-items: center; 
  border-top: 1rpx solid #f0f0f0; 
  padding-top: 20rpx; 
}
.stats { 
  font-size: 24rpx; 
  color: #999; 
}

/* 预览按钮：紫色渐变 */
.share-btn { 
  margin: 0; 
  padding: 0 30rpx; 
  height: 60rpx; 
  line-height: 60rpx; 
  font-size: 24rpx; 
  background: linear-gradient(135deg, #673AB7, #9C27B0); 
  color: white; 
  border-radius: 30rpx; 
}

/* 底部悬浮添加按钮 */
.add-btn { 
  position: fixed; 
  bottom: 40rpx; 
  left: 10%; 
  width: 80%; 
  background: #333; 
  color: white; 
  border-radius: 50rpx; 
  font-size: 30rpx; 
  font-weight: bold; 
  box-shadow: 0 10rpx 30rpx rgba(51,51,51,0.3); 
}