page { background: #f7f8fa; }

/* 头部：深色沉浸式背景 */
.header-card {
  height: 350rpx; /* 调整了高度让它更精致 */
  background: linear-gradient(180deg, #673AB7 0%, #9C27B0 100%); 
  display: flex;
  justify-content: space-between; /* 🌟 让标题和按钮分居左右 */
  align-items: center;
  padding: 0 50rpx; /* 增加左右内边距 */
  position: relative;
  overflow: hidden;
}

.points-val {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff; 
  letter-spacing: 2rpx;
  text-shadow: 0 4rpx 10rpx rgba(0,0,0,0.2);
  z-index: 5;
}

/* 🌟 新增：半透明磨砂质感的上架按钮 */
.add-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  color: #fff;
  padding: 12rpx 28rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  font-weight: bold;
  z-index: 5;
  display: flex;
  align-items: center;
  backdrop-filter: blur(4px); /* 磨砂玻璃特效 */
  transition: all 0.2s;
}
.add-btn:active { transform: scale(0.95); background: rgba(255,255,255,0.3); }
.plus-icon { font-size: 32rpx; margin-right: 6rpx; margin-top: -4rpx; }

/* 背景装饰球 */
.bg-deco-1 { position: absolute; width: 300rpx; height: 300rpx; background: rgba(255,255,255,0.05); border-radius: 50%; top: -50rpx; right: -50rpx; }
.bg-deco-2 { position: absolute; width: 200rpx; height: 200rpx; background: rgba(255,255,255,0.02); border-radius: 50%; bottom: 10rpx; left: -30rpx; }

/* 内容主体 */
.module-box {
  padding: 40rpx 30rpx;
  margin-top: -60rpx; /* 向上悬浮 */
  background: #f7f8fa;
  border-radius: 40rpx 40rpx 0 0;
  position: relative;
  z-index: 10;
}

.module-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 30rpx; border-left: 8rpx solid #673AB7; padding-left: 16rpx; }

.empty-tip { text-align: center; color: #999; font-size: 28rpx; padding: 60rpx 0; }

/* 列表卡片 */
.item-list { display: flex; flex-direction: column; }
.item-card { background: #fff; border-radius: 32rpx; padding: 30rpx; display: flex; align-items: center; margin-bottom: 24rpx; box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.03); }
.item-main { flex: 1; display: flex; align-items: center; }
.item-icon { font-size: 70rpx; margin-right: 24rpx; background: #fcfcff; width: 100rpx; height: 100rpx; display: flex; justify-content: center; align-items: center; border-radius: 20rpx; }
.item-info { display: flex; flex-direction: column; }
.item-name { font-size: 28rpx; color: #333; font-weight: bold; margin-bottom: 12rpx; }
.tag-row { display: flex; align-items: center; }
.tag-price { color: #FF5722; font-size: 24rpx; font-weight: bold; margin-right: 16rpx; }
.tag-category { background: rgba(103,58,183,0.1); color: #673AB7; font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; }

/* 温柔的红色渐变下架按钮 */
.delete-btn { background: linear-gradient(135deg, #FF5722 0%, #FF9800 100%); color: #fff; font-size: 24rpx; padding: 12rpx 30rpx; border-radius: 30rpx; font-weight: bold; box-shadow: 0 4rpx 10rpx rgba(255,87,34,0.2); }