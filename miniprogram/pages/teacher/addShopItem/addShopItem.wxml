<view class="container">
  <view class="header-card">
    <view class="title">上架商城商品</view>
    <view class="subtitle">支持虚拟权益、实物福利和灵宠道具，都会自动带上当前校区信息。</view>
  </view>

  <view class="form-box">
    <view class="input-item">
      <text class="label">商品名称</text>
      <input class="input" placeholder="例如：月度打卡徽章 / 单词挑战礼包" model:value="{{name}}" />
    </view>

    <view class="input-item">
      <text class="label">商品封面</text>
      <view class="upload-box" bindtap="chooseImage">
        <image wx:if="{{imageUrl}}" src="{{imageUrl}}" mode="aspectFill" class="preview-img"></image>
        <view wx:else class="upload-btn">
          <text class="plus">+</text>
          <text class="upload-text">点击上传图片</text>
        </view>
      </view>
    </view>

    <view class="input-item">
      <text class="label">兑换积分</text>
      <input class="input" type="number" placeholder="例如：100" model:value="{{price}}" />
    </view>

    <view class="input-item">
      <text class="label">商品类型</text>
      <picker bindchange="onTypeChange" value="{{typeIndex}}" range="{{types}}">
        <view class="picker-box">{{types[typeIndex]}} <text class="arrow">▾</text></view>
      </picker>
    </view>

    <view class="input-item">
      <text class="label">商品说明</text>
      <input class="input" placeholder="一句话说明兑换后会获得什么" model:value="{{propDesc}}" />
    </view>

    <view class="prop-config-box" wx:if="{{typeIndex === 2}}">
      <view class="prop-title">灵宠道具效果配置</view>
      <view class="prop-row">
        <text class="prop-label">道具图标</text>
        <input class="prop-input" model:value="{{propIcon}}" placeholder="例如：宠 / 火 / 水" />
      </view>

      <view class="prop-grid">
        <view class="p-item"><text>经验</text><input type="number" model:value="{{addExp}}" /></view>
        <view class="p-item"><text>金</text><input type="number" model:value="{{addJin}}" /></view>
        <view class="p-item"><text>木</text><input type="number" model:value="{{addMu}}" /></view>
        <view class="p-item"><text>水</text><input type="number" model:value="{{addShui}}" /></view>
        <view class="p-item"><text>火</text><input type="number" model:value="{{addHuo}}" /></view>
        <view class="p-item"><text>土</text><input type="number" model:value="{{addTu}}" /></view>
      </view>
    </view>

    <button class="submit-btn" bindtap="submit">确认上架</button>
  </view>
</view>
