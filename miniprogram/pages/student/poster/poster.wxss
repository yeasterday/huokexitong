page { background: #2b2d3a; } /* 给个深色背景，衬托海报 */

.poster-container { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  padding-top: 60rpx; 
}

.canvas-box { 
  width: 600rpx; 
  height: 900rpx; 
  background: #fff; 
  border-radius: 20rpx; 
  overflow: hidden; 
  position: relative; 
  box-shadow: 0 20rpx 40rpx rgba(0,0,0,0.5);
}

/* 将真正的 Canvas 移出屏幕外，防止干扰页面布局 */
.poster-canvas { 
  width: 100%; 
  height: 100%; 
  position: absolute; 
  top: -9999px; 
  left: -9999px; 
} 

/* 最终显示的图片 */
.preview-img { 
  width: 100%; 
  height: 100%; 
  display: block; 
}

.save-btn { 
  margin-top: 80rpx; 
  width: 80%; 
  background: linear-gradient(135deg, #FF416C, #FF4B2B); 
  color: #fff; 
  border-radius: 50rpx; 
  height: 100rpx; 
  line-height: 100rpx; 
  font-weight: bold; 
  font-size: 32rpx;
  box-shadow: 0 10rpx 20rpx rgba(255,65,108,0.3);
}

.tips { 
  margin-top: 30rpx; 
  font-size: 24rpx; 
  color: #999; 
}