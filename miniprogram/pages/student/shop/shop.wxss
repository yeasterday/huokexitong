page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.hero {
  padding: 34rpx 24rpx 28rpx;
  background: linear-gradient(160deg, #21344a, #375775);
  border-radius: 0 0 36rpx 36rpx;
  color: #fff;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
}

.score-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.08);
}

.score-num {
  display: block;
  font-size: 54rpx;
  font-weight: 700;
}

.score-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  padding: 18rpx 24rpx 0;
}

.filter-chip {
  margin-right: 12rpx;
  margin-top: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #eaf0f6;
  color: #667b90;
  font-size: 22rpx;
}

.filter-chip.active {
  background: #21344a;
  color: #fff;
}

.list {
  padding: 12rpx 24rpx 0;
}

.goods-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.goods-top {
  display: flex;
  align-items: flex-start;
}

.goods-icon,
.goods-image {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  margin-right: 20rpx;
}

.goods-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf4ff;
  color: #447be5;
  font-size: 32rpx;
  font-weight: 700;
}

.goods-main {
  flex: 1;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #23384c;
}

.goods-tag {
  display: inline-block;
  margin-top: 12rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  color: #667b90;
  font-size: 22rpx;
}

.goods-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f7488;
}

.goods-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.goods-price {
  font-size: 30rpx;
  font-weight: 700;
  color: #e57737;
}

.exchange-btn {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #21344a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.state-box {
  margin-top: 18rpx;
  padding: 36rpx 0;
  text-align: center;
  color: #7c8d9f;
  font-size: 24rpx;
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(24, 39, 57, 0.45);
  display: flex;
  align-items: flex-end;
  z-index: 99;
}

.buy-modal {
  width: 100%;
  padding: 30rpx 24rpx 40rpx;
  border-radius: 32rpx 32rpx 0 0;
  background: #fff;
}

.modal-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #23384c;
}

.modal-name {
  margin-top: 18rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #23384c;
}

.modal-price {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #7c8d9f;
}

.qty-row,
.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}

.qty-label {
  font-size: 26rpx;
  color: #23384c;
}

.stepper {
  display: flex;
  align-items: center;
  border: 2rpx solid #e1e8f0;
  border-radius: 18rpx;
  overflow: hidden;
}

.step-btn,
.step-num {
  width: 68rpx;
  height: 58rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step-btn {
  background: #f5f7fb;
  font-size: 30rpx;
  color: #23384c;
}

.step-num {
  font-size: 24rpx;
  color: #23384c;
}

.address-box {
  margin-top: 24rpx;
}

.address-label {
  display: block;
  font-size: 24rpx;
  color: #6d8297;
}

.address-input {
  width: 100%;
  height: 160rpx;
  margin-top: 12rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #f5f7fb;
  box-sizing: border-box;
  font-size: 24rpx;
  color: #23384c;
}

.total-row {
  font-size: 28rpx;
  color: #23384c;
}

.total-price {
  font-size: 34rpx;
  font-weight: 700;
  color: #e57737;
}

.confirm-btn {
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: #21344a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
