page { background: #f7f8fa; color: #333; font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', sans-serif; }
.container { padding-bottom: 60rpx; }

/* 1. 顶部紫色背景区 */
.header-section {
  background: linear-gradient(180deg, #673AB7 0%, #9C27B0 100%);
  padding: 40rpx 30rpx 120rpx;
  position: relative;
}

.user-info { display: flex; align-items: center; margin-bottom: 40rpx; }

/* 🌟 头像相关样式 */
.avatar-wrapper { position: relative; margin-right: 24rpx; }
.avatar-circle {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  background: #eee; font-size: 60rpx; display: flex; justify-content: center; align-items: center;
}
.edit-badge {
  position: absolute; right: 0; bottom: 0;
  background: #fff; width: 40rpx; height: 40rpx; border-radius: 50%;
  display: flex; justify-content: center; align-items: center;
  font-size: 22rpx; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.2);
}

.text-info { color: #fff; }
/* 🌟 名字和修改图标同行显示 */
.nickname-row { display: flex; align-items: center; margin-bottom: 8rpx; }
.nickname { font-size: 36rpx; font-weight: bold; }
.edit-icon { font-size: 24rpx; margin-left: 12rpx; opacity: 0.8; }
.user-id { font-size: 22rpx; opacity: 0.8; display: flex; align-items: center; }

/* 标签样式 */
.tag {
  margin-left: 15rpx; font-size: 18rpx; padding: 2rpx 12rpx;
  border-radius: 20rpx; background: rgba(255,255,255,0.2);
  border: 1rpx solid rgba(255,255,255,0.4);
}
.tag.unbound { 
  background: #FF5722; color: #fff; border: none; font-weight: bold;
  animation: breathe 2s infinite;
}
@keyframes breathe { 0%, 100% { opacity: 1; } 50% { opacity: 0.7; } }

/* 2. 高级VIP卡片 */
.vip-card-enhanced { background: linear-gradient(135deg, #2d2e37 0%, #1a1b21 100%); border-radius: 24rpx; padding: 30rpx; color: #f0c78a; box-shadow: 0 15rpx 30rpx rgba(0,0,0,0.2); position: relative; overflow: hidden; }
.vip-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 25rpx; }
.vip-title { font-size: 30rpx; font-weight: bold; letter-spacing: 2rpx; }
.vip-status { font-size: 20rpx; border: 1rpx solid #f0c78a; padding: 2rpx 12rpx; border-radius: 20rpx; }
.vip-middle { display: flex; justify-content: space-between; margin-bottom: 30rpx; }
.benefit-item { font-size: 22rpx; display: flex; align-items: center; }
.benefit-item .icon { margin-right: 6rpx; }
.vip-bottom { display: flex; justify-content: space-between; align-items: center; border-top: 1rpx solid rgba(240,199,138,0.2); padding-top: 20rpx; }
.vip-hint { font-size: 20rpx; opacity: 0.6; }
.vip-btn { background: #f0c78a; color: #1a1b21; font-size: 22rpx; font-weight: bold; padding: 10rpx 24rpx; border-radius: 30rpx; }

/* 3. 盟主大盘入口 */
.boss-entrance { margin-top: 30rpx; background: rgba(255,255,255,0.1); padding: 20rpx 30rpx; border-radius: 16rpx; display: flex; justify-content: space-between; align-items: center; color: #fff; font-size: 28rpx; font-weight: bold; }

/* 4. 资产数据区 */
.assets-section { background: #fff; margin: -60rpx 30rpx 30rpx; border-radius: 24rpx; padding: 30rpx; display: flex; align-items: center; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.05); position: relative; z-index: 10; }
.asset-item { flex: 1; text-align: center; }
.asset-num { font-size: 36rpx; font-weight: bold; color: #333; margin-bottom: 6rpx; }
.asset-name { font-size: 22rpx; color: #999; }
.checkin-wrap { flex: 1.5; padding-left: 20rpx; border-left: 2rpx solid #f0f0f0; }
.checkin-btn { background: #e8f5e9; color: #4caf50; height: 70rpx; border-radius: 35rpx; display: flex; justify-content: center; align-items: center; font-size: 24rpx; font-weight: bold; }
.checkin-btn.disabled { background: #f5f5f5; color: #bbb; }
.c-icon { margin-right: 8rpx; }

/* 5. 模块网格区 */
.module-section { background: #fff; margin: 0 30rpx 30rpx; border-radius: 24rpx; padding: 30rpx; }
.module-title { font-size: 30rpx; font-weight: bold; color: #333; margin-bottom: 30rpx; display: flex; justify-content: space-between; align-items: center; }
.title-more { font-size: 22rpx; color: #999; font-weight: normal; }

/* 🌟 全新升级的网格样式 */
.grid-wrap { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.grid-wrap .grid-item { width: 25%; display: flex; flex-direction: column; align-items: center; margin-bottom: 40rpx; }
.grid-icon-box { 
  width: 90rpx; height: 90rpx; border-radius: 28rpx; 
  display: flex; justify-content: center; align-items: center; 
  font-size: 44rpx; margin-bottom: 16rpx; 
}
.grid-text { font-size: 22rpx; color: #555; font-weight: bold; }

/* 各种高级感的马卡龙底色 */
.bg-blue { background: #E3F2FD; }
.bg-orange { background: #FFF3E0; }
.bg-green { background: #E8F5E9; }
.bg-yellow { background: #FFF8E1; }
.bg-purple { background: #F3E5F5; }
.bg-red { background: #FFEBEE; }
.bg-teal { background: #E0F2F1; }
.bg-indigo { background: #E8EAF6; }
.bg-pink { background: #FCE4EC; }
.grid-item { width: 25%; display: flex; flex-direction: column; align-items: center; margin-bottom: 10rpx; }
.grid-icon { font-size: 50rpx; margin-bottom: 12rpx; }
.grid-text { font-size: 22rpx; color: #666; }

/* 6. 手机绑定弹窗 */
.modal-mask { position: fixed; top: 0; left: 0; width: 100%; height: 100vh; background: rgba(0,0,0,0.6); z-index: 999; display: flex; justify-content: center; align-items: center; }
.modal-content { width: 80%; background: #fff; border-radius: 30rpx; padding: 50rpx 40rpx; text-align: center; }
.modal-title { font-size: 36rpx; font-weight: bold; margin-bottom: 20rpx; }
.modal-desc { font-size: 26rpx; color: #666; margin-bottom: 40rpx; line-height: 1.5; }
.phone-input { height: 90rpx; background: #f4f6f9; border-radius: 12rpx; text-align: left; padding: 0 30rpx; font-size: 30rpx; margin-bottom: 40rpx; }
.modal-btns { display: flex; justify-content: space-between; }
.cancel-btn { width: 45%; height: 80rpx; line-height: 80rpx; background: #eee; border-radius: 40rpx; font-size: 28rpx; }
.confirm-btn { width: 45%; height: 80rpx; line-height: 80rpx; background: #673AB7; color: #fff; border-radius: 40rpx; font-size: 28rpx; font-weight: bold; }

/* 退出登录按钮样式 */
.logout-section { margin-top: 50rpx; padding: 0 10rpx 60rpx; }
.logout-btn { background: #fff; color: #e53935; text-align: center; padding: 32rpx 0; border-radius: 24rpx; font-size: 32rpx; font-weight: bold; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.03); transition: all 0.2s; }
.logout-btn:active { background: #f9f9f9; transform: scale(0.98); }