page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.hero {
  padding: 34rpx 24rpx 120rpx;
  background: linear-gradient(160deg, #21344a, #375775);
  border-radius: 0 0 36rpx 36rpx;
  color: #fff;
}

.user-row {
  display: flex;
  align-items: center;
}

.avatar-wrap {
  margin-right: 22rpx;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.14);
}

.avatar.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 700;
}

.user-main {
  flex: 1;
}

.name-line {
  display: flex;
  align-items: center;
}

.user-name {
  font-size: 38rpx;
  font-weight: 700;
}

.user-edit {
  margin-left: 14rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 20rpx;
}

.user-meta {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
}

.user-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 14rpx;
}

.tag {
  margin-right: 12rpx;
  margin-top: 8rpx;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 20rpx;
}

.hero-actions {
  margin-top: 24rpx;
}

.hero-btn {
  border-radius: 999rpx;
  background: #fff;
  color: #21344a;
  font-size: 28rpx;
  font-weight: 600;
}

.hero-stats {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  margin-top: 28rpx;
}

.hero-stat {
  width: 48%;
  margin-top: 14rpx;
  padding: 22rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.08);
}

.hero-num {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
}

.hero-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.progress-card,
.quick-card,
.section {
  margin: -82rpx 24rpx 20rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 14rpx 34rpx rgba(31, 52, 82, 0.06);
}

.quick-card,
.section {
  margin-top: 0;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title,
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #23384c;
}

.card-link {
  font-size: 24rpx;
  color: #447be5;
}

.progress-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.progress-bar {
  flex: 1;
  height: 18rpx;
  border-radius: 999rpx;
  background: #edf2f7;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #447be5, #5ac6ac);
}

.progress-num {
  margin-left: 18rpx;
  font-size: 24rpx;
  color: #23384c;
  font-weight: 600;
}

.progress-desc {
  margin-top: 14rpx;
  font-size: 22rpx;
  line-height: 1.7;
  color: #7c8d9f;
}

.quick-card {
  display: flex;
  justify-content: space-between;
}

.quick-item {
  width: 31%;
  padding: 16rpx 12rpx;
  border-radius: 22rpx;
  background: #f5f7fb;
  text-align: center;
}

.quick-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #23384c;
}

.quick-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7c8d9f;
}

.menu-list {
  margin-top: 16rpx;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #eef2f6;
  font-size: 28rpx;
  color: #23384c;
}

.menu-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.menu-extra {
  font-size: 22rpx;
  color: #7c8d9f;
}

.footer-action {
  padding: 0 24rpx 10rpx;
}

.logout-btn {
  border-radius: 999rpx;
  background: #fff;
  color: #d85045;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(24, 39, 57, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 99;
}

.modal-card {
  width: 78%;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #fff;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #23384c;
}

.modal-input {
  margin-top: 22rpx;
  height: 84rpx;
  border-radius: 20rpx;
  background: #f5f7fb;
  padding: 0 22rpx;
  font-size: 26rpx;
}

.modal-actions {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.modal-btn {
  width: 47%;
  height: 82rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.modal-btn.secondary {
  background: #f1f5f9;
  color: #5d7288;
}

.modal-btn.primary {
  background: #21344a;
  color: #fff;
}
