<view class="page">
  <view class="hero">
    <view class="user-row">
      <view class="avatar-wrap" catchtap="changeAvatar">
        <image
          class="avatar"
          mode="aspectFill"
          src="{{userInfo.avatar || userInfo.avatarUrl}}"
          wx:if="{{userInfo.avatar || userInfo.avatarUrl}}"
        ></image>
        <view class="avatar placeholder" wx:else>{{guestMode ? '登' : avatarText}}</view>
      </view>

      <view class="user-main" catchtap="handleNameTap">
        <view class="name-line">
          <text class="user-name">{{guestMode ? '点击登录' : (userInfo.nickname || userInfo.name || '未命名用户')}}</text>
          <text class="user-edit" wx:if="{{!guestMode}}">编辑</text>
        </view>
        <view class="user-meta">{{guestMode ? '登录后可同步闯关、资料、订单和成长档案' : (userInfo.orgName || '未绑定校区')}}</view>
        <view class="user-tags" wx:if="{{!guestMode}}">
          <text class="tag">{{userInfo.phone ? '已绑定手机' : '待绑定手机'}}</text>
          <text class="tag" wx:if="{{userInfo.role === 'teacher'}}">教师账号</text>
        </view>
      </view>
    </view>

    <view class="hero-actions" wx:if="{{guestMode}}">
      <button class="hero-btn" bindtap="goToLogin">立即登录</button>
    </view>

    <view class="hero-stats" wx:else>
      <view class="hero-stat">
        <text class="hero-num">{{score}}</text>
        <text class="hero-label">积分</text>
      </view>
      <view class="hero-stat">
        <text class="hero-num">{{resourceCount}}</text>
        <text class="hero-label">已得资料</text>
      </view>
      <view class="hero-stat">
        <text class="hero-num">{{streak}}</text>
        <text class="hero-label">连学天数</text>
      </view>
      <view class="hero-stat">
        <text class="hero-num">{{unreadCount}}</text>
        <text class="hero-label">未读消息</text>
      </view>
    </view>
  </view>

  <view class="progress-card" wx:if="{{!guestMode}}">
    <view class="card-head">
      <text class="card-title">资料完整度</text>
      <text class="card-link" bindtap="goToArchive">去完善</text>
    </view>
    <view class="progress-row">
      <view class="progress-bar">
        <view class="progress-fill" style="width: {{profilePercent}}%;"></view>
      </view>
      <text class="progress-num">{{profilePercent}}%</text>
    </view>
    <view class="progress-desc">完善年级、城市、目标学校和学习目标后，系统会给你更匹配的内容推荐。</view>
  </view>

  <view class="quick-card" wx:if="{{!guestMode}}">
    <view class="quick-item" bindtap="doCheckIn">
      <view class="quick-value">{{hasCheckedIn ? '已签到' : '+5 积分'}}</view>
      <view class="quick-label">每日签到</view>
    </view>
    <view class="quick-item" bindtap="openPhoneModal">
      <view class="quick-value">{{userInfo.phone ? '已绑定' : '去绑定'}}</view>
      <view class="quick-label">手机号</view>
    </view>
    <view class="quick-item" bindtap="goToGrowth">
      <view class="quick-value">时间线</view>
      <view class="quick-label">成长记录</view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">我的学习</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="openGrowth">
        <text>成长时间线</text>
        <text class="menu-extra">查看成长轨迹</text>
      </view>
      <view class="menu-item" bindtap="openArchive">
        <text>学习档案</text>
        <text class="menu-extra">{{guestMode ? '登录后可用' : '完善资料与目标'}}</text>
      </view>
      <view class="menu-item" bindtap="openRank">
        <text>排行榜</text>
        <text class="menu-extra">看当前排名</text>
      </view>
      <view class="menu-item" bindtap="openPet">
        <text>灵宠空间</text>
        <text class="menu-extra">查看宠物成长</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">我的资产</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="openResources">
        <text>我的资料</text>
        <text class="menu-extra">{{resourceCount}} 份资料</text>
      </view>
      <view class="menu-item" bindtap="openOrders">
        <text>我的订单</text>
        <text class="menu-extra">{{pendingOrders > 0 ? pendingOrders + ' 个待处理' : '查看全部订单'}}</text>
      </view>
      <view class="menu-item" bindtap="goToShop">
        <text>积分商城</text>
        <text class="menu-extra">去兑换内容和福利</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">互动中心</view>
    <view class="menu-list">
      <view class="menu-item" bindtap="openMessages">
        <text>消息中心</text>
        <text class="menu-extra">{{unreadCount > 0 ? unreadCount + ' 条未读' : '查看互动提醒'}}</text>
      </view>
      <view class="menu-item" bindtap="openMoments">
        <text>我的主页</text>
        <text class="menu-extra">查看动态与互动</text>
      </view>
      <view class="menu-item" bindtap="goToDashboard" wx:if="{{userInfo.role === 'teacher'}}">
        <text>教师工作台</text>
        <text class="menu-extra">机构运营与学生看板</text>
      </view>
    </view>
  </view>

  <view class="footer-action" wx:if="{{!guestMode}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>

  <view class="modal-mask" wx:if="{{showPhoneModal}}">
    <view class="modal-card">
      <view class="modal-title">绑定手机号</view>
      <input
        class="modal-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        value="{{phoneNumber}}"
        data-field="phoneNumber"
        bindinput="handleInput"
      />
      <view class="modal-actions">
        <view class="modal-btn secondary" bindtap="closePhoneModal">取消</view>
        <view class="modal-btn primary" bindtap="savePhone">保存</view>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showNameModal}}">
    <view class="modal-card">
      <view class="modal-title">修改昵称</view>
      <input
        class="modal-input"
        maxlength="20"
        placeholder="请输入新的昵称"
        value="{{newNickname}}"
        data-field="newNickname"
        bindinput="handleInput"
      />
      <view class="modal-actions">
        <view class="modal-btn secondary" bindtap="closeNameModal">取消</view>
        <view class="modal-btn primary" bindtap="saveNickname">保存</view>
      </view>
    </view>
  </view>
</view>
