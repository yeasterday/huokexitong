page { background: #f6f7fb; }
.page { min-height: 100vh; padding: 28rpx; box-sizing: border-box; }
.hero { padding: 34rpx 30rpx; border-radius: 30rpx; background: linear-gradient(140deg, #4f46b7 0%, #6b63da 100%); color: #fff; box-shadow: 0 20rpx 48rpx rgba(79,70,183,0.18); }
.hero-title { display: block; font-size: 40rpx; font-weight: 900; }
.hero-desc { display: block; margin-top: 14rpx; font-size: 24rpx; line-height: 1.8; opacity: 0.88; }
.panel { margin-top: 28rpx; padding: 26rpx 24rpx; border-radius: 28rpx; background: #fff; box-shadow: 0 10rpx 26rpx rgba(0,0,0,0.04); }
.panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18rpx; }
.panel-title { font-size: 30rpx; font-weight: 800; color: #22263c; }
.panel-link { font-size: 22rpx; color: #7c8197; }
.video-card { display: flex; gap: 18rpx; padding: 18rpx 0; border-bottom: 2rpx solid #f2f4f8; }
.video-card:last-child { border-bottom: none; }
.video-thumb { width: 88rpx; height: 88rpx; border-radius: 24rpx; background: #eef1ff; display: flex; align-items: center; justify-content: center; font-size: 38rpx; flex-shrink: 0; }
.video-main { flex: 1; min-width: 0; }
.video-title { display: block; font-size: 28rpx; font-weight: 700; color: #2c3147; }
.video-desc { display: block; margin-top: 10rpx; font-size: 22rpx; color: #8d92a4; line-height: 1.7; }
.course-card { padding: 18rpx 0; border-bottom: 2rpx solid #f2f4f8; }
.course-card:last-child { border-bottom: none; }
.course-title { display: block; font-size: 28rpx; font-weight: 700; color: #2c3147; }
.course-desc { display: block; margin-top: 10rpx; font-size: 22rpx; color: #8d92a4; }
.empty { text-align: center; color: #9ca1b3; font-size: 24rpx; padding: 18rpx 0 6rpx; }
