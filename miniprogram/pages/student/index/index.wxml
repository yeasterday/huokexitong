<view class="saas-container">
  
  <view class="header-section">
    <view class="user-info-box" bindtap="goToProfile">
      <image class="user-avatar" src="{{userInfo.avatarUrl || userInfo.avatar || 'https://api.dicebear.com/7.x/avataaars/svg?seed=guest'}}"></image>
      <view class="user-text">
        <view class="user-name">{{userInfo.nickname || userInfo.name || '请点击登录'}}</view>
        <view class="user-role" wx:if="{{userInfo._id}}">{{userInfo.orgName ? '🚩 ' + userInfo.orgName : '青源智盟学员'}}</view>
      </view>
    </view>

    <view class="search-box">
      <icon type="search" size="16" color="#999"></icon>
      <input class="search-input" type="text" placeholder="搜政策、搜真题、搜笔记..." confirm-type="search" model:value="{{keyword}}" bindconfirm="onSearch" />
      <icon type="clear" size="16" color="#ccc" wx:if="{{keyword}}" bindtap="clearSearch" class="clear-icon"></icon>
    </view>
  </view>

  <view class="nav-grid">
    <view class="nav-item" bindtap="navToPolicy"><view class="icon-box bg-blue"><text class="emoji-icon">⚖️</text></view><text class="nav-text">政策解读</text></view>
    <view class="nav-item" bindtap="navToResource"><view class="icon-box bg-green"><text class="emoji-icon">📚</text></view><text class="nav-text">资源贴吧</text></view>
    <view class="nav-item" bindtap="navToVideo"><view class="icon-box bg-purple"><text class="emoji-icon">🎬</text></view><text class="nav-text">精品视频</text></view>
    <view class="nav-item" bindtap="navToPoints"><view class="icon-box bg-yellow"><text class="emoji-icon">💰</text></view><text class="nav-text">积分兑换</text></view>
    <view class="nav-item" bindtap="navToSchools"><view class="icon-box bg-orange"><text class="emoji-icon">🏢</text></view><text class="nav-text">入驻机构</text></view>
  </view>

  <view class="notice-bar">
    <view class="notice-tag">热议</view>
    <swiper vertical="true" autoplay="true" circular="true" class="notice-swiper">
      <swiper-item><text class="notice-text">某同学刚用积分兑换了专属体验课...</text></swiper-item>
      <swiper-item><text class="notice-text">2026年本市小升初最新政策已发布！</text></swiper-item>
    </swiper>
  </view>

  <view class="circle-section">
    <view class="section-header">
      <text class="section-title">班级圈</text>
      <text class="section-sub">发现牛人，立刻关注</text>
    </view>
    <view class="moment-list">
      <view class="moment-item" wx:for="{{moments}}" wx:key="_id">
        <image class="m-avatar" src="{{item.avatarUrl || item.avatar}}" bindtap="goToUserPage" data-userid="{{item.userId}}"></image>
        
        <view class="m-content-area">
          <view class="m-name-row">
            <view class="m-name">{{item.name}}</view>
            <view class="follow-btn {{item.isFollowed ? 'followed' : ''}}" wx:if="{{item.userId && item.userId !== userInfo._id}}" bindtap="followAuthor" data-index="{{index}}">
              {{item.isFollowed ? '已关注' : '+ 关注'}}
            </view>
          </view>
          <view class="m-text">{{item.content}}</view>
          <view class="m-images" wx:if="{{item.images && item.images.length > 0}}">
            <image class="m-img" wx:for="{{item.images}}" wx:for-item="img" wx:key="*this" src="{{img}}" mode="aspectFill"></image>
          </view>
          <view class="m-footer">
            <text class="m-time">{{item.time}}</text>
            <view class="m-actions">
              <view class="action-btn" bindtap="toggleLike" data-index="{{index}}">
                <text>{{item.isLiked ? '❤️' : '🤍'}}</text>
                <text class="action-num">{{item.likes || 0}}</text>
              </view>
              <view class="action-btn" bindtap="openComment" data-index="{{index}}">
                <text>💬</text>
                <text class="action-num">{{item.comments || 0}}</text>
              </view>
            </view>
          </view>
          <view class="comment-area" wx:if="{{item.commentsList && item.commentsList.length > 0}}">
            <view class="comment-item" wx:for="{{item.commentsList}}" wx:for-item="cmt" wx:key="time">
              <text class="c-name">{{cmt.name}}：</text>
              <text class="c-content">{{cmt.content}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="fab-btn" bindtap="goToPublish"><text class="fab-icon">+</text><text class="fab-text">发布</text></view>

  <view class="comment-mask" wx:if="{{showCommentInput}}" bindtap="closeComment"></view>
  <view class="comment-input-bar" wx:if="{{showCommentInput}}">
    <input class="c-input" focus="{{showCommentInput}}" cursor-spacing="20" placeholder="善语结善缘..." bindinput="handleCommentInput" value="{{commentContent}}" confirm-type="send" bindconfirm="sendComment" />
    <view class="c-send-btn" bindtap="sendComment">发送</view>
  </view>

</view>