page { background: #fff; font-family: -apple-system, sans-serif; }
.publish-container { padding: 30rpx; display: flex; flex-direction: column; min-height: 100vh; }

/* 文本输入区 */
.input-section { position: relative; width: 100%; margin-bottom: 40rpx; }
.text-content { width: 100%; height: 260rpx; font-size: 30rpx; color: #333; line-height: 1.5; padding: 10rpx 0; }
.word-count { position: absolute; right: 0; bottom: -10rpx; font-size: 24rpx; color: #999; }

/* 图片上传区 */
.image-section { border-top: 2rpx solid #f4f6f9; padding-top: 40rpx; }
.img-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.img-box { position: relative; width: 216rpx; height: 216rpx; border-radius: 12rpx; overflow: hidden; }
.uploaded-img { width: 100%; height: 100%; background: #f0f0f0; }
.delete-icon { 
  position: absolute; top: 0; right: 0; 
  background: rgba(0,0,0,0.5); color: #fff; 
  width: 40rpx; height: 40rpx; 
  display: flex; justify-content: center; align-items: center; 
  border-bottom-left-radius: 12rpx; font-size: 28rpx; 
}

.add-btn { 
  width: 216rpx; height: 216rpx; background: #f4f6f9; border-radius: 12rpx; 
  display: flex; justify-content: center; align-items: center; 
}
.add-icon { font-size: 80rpx; color: #ccc; font-weight: 300; margin-top: -10rpx; }

/* 底部按钮 */
.footer-section { margin-top: auto; padding: 60rpx 0 40rpx; padding-bottom: env(safe-area-inset-bottom); }
.submit-btn { 
  background: #673AB7; color: #fff; border-radius: 50rpx; 
  height: 90rpx; line-height: 90rpx; font-size: 32rpx; font-weight: bold; 
  box-shadow: 0 8rpx 20rpx rgba(103,58,183,0.3); 
}
.submit-btn[disabled] { background: #a78bfa !important; color: #fff !important; }