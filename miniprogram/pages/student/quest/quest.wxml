<view class="quest-container">
  <view wx:if="{{step === 'dashboard'}}" class="dashboard-state">
    <view class="hero">
      <view class="hero-top">
        <view>
          <view class="hero-title">今日词汇闯关</view>
          <view class="hero-subtitle">{{todayDone ? '今天已经完成一次闯关，继续练会更稳' : '完成 5 个新词学习和测验，积累连续学习天数'}}</view>
        </view>
        <view class="hero-status {{todayDone ? 'done' : ''}}">{{todayDone ? '已完成' : '待开始'}}</view>
      </view>

      <view class="hero-stats">
        <view class="hero-stat">
          <text class="hero-num">{{totalLearned || 0}}</text>
          <text class="hero-label">当前词库已学</text>
        </view>
        <view class="hero-stat">
          <text class="hero-num">{{streak || 0}}</text>
          <text class="hero-label">连续闯关</text>
        </view>
        <view class="hero-stat">
          <text class="hero-num">{{score || 0}}</text>
          <text class="hero-label">当前积分</text>
        </view>
      </view>
    </view>

    <view class="panel bank-panel">
      <view class="panel-title">选择词库</view>
      <view class="bank-switch">
        <view class="switch-btn {{currentBankId === 'zhongkao' ? 'active' : ''}}" bindtap="changeBank" data-id="zhongkao">中考</view>
        <view class="switch-btn {{currentBankId === 'gaokao' ? 'active' : ''}}" bindtap="changeBank" data-id="gaokao">高考</view>
      </view>
      <view class="bank-card">
        <view class="bank-icon">A</view>
        <view class="bank-info">
          <view class="bank-name">{{bankConfig[currentBankId].name}}</view>
          <view class="bank-progress">进度 {{totalLearned || 0}} / {{bankConfig[currentBankId].total}}</view>
        </view>
      </view>
      <button class="start-btn" bindtap="startLearning">开始本轮闯关</button>
    </view>

    <view class="panel summary-panel">
      <view class="panel-title">学习看板</view>
      <view class="summary-grid">
        <view class="summary-item">
          <text class="summary-value">{{recordCount || 0}}</text>
          <text class="summary-label">最近记录数</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{recentAccuracy || 0}}%</text>
          <text class="summary-label">近期正确率</text>
        </view>
        <view class="summary-item">
          <text class="summary-value">{{wrongbookCount || 0}}</text>
          <text class="summary-label">错词本</text>
        </view>
      </view>
    </view>

    <view class="tool-grid">
      <view class="tool-card" bindtap="goToRecords">
        <view class="tool-icon orange">记录</view>
        <view class="tool-name">闯关记录</view>
        <view class="tool-desc">看每次成绩和复盘</view>
      </view>
      <view class="tool-card" bindtap="goToWrongbook">
        <view class="tool-icon red">错词</view>
        <view class="tool-name">错词本</view>
        <view class="tool-desc">集中巩固薄弱单词</view>
      </view>
      <view class="tool-card" bindtap="goToCalendar">
        <view class="tool-icon blue">日历</view>
        <view class="tool-name">学习日历</view>
        <view class="tool-desc">签到和闯关轨迹</view>
      </view>
      <view class="tool-card" bindtap="goToRank">
        <view class="tool-icon green">排行</view>
        <view class="tool-name">成长榜单</view>
        <view class="tool-desc">看看你的位置</view>
      </view>
    </view>
  </view>

  <view wx:if="{{step === 'learn'}}" class="learn-state">
    <view class="top-bar">
      <text class="progress-text">学新词 {{currentIndex + 1}} / {{wordList.length}}</text>
      <view class="close-btn" bindtap="quitToDashboard">退出</view>
    </view>

    <view class="word-card">
      <image class="word-img" src="{{currentWord.imgUrl}}" mode="aspectFill" wx:if="{{currentWord.imgUrl}}"></image>
      <view class="word-placeholder" wx:else>WORD</view>
      <view class="word-title">{{currentWord.word}}</view>
      <view class="phonetic-row" bindtap="playAudio">
        <text class="phonetic">{{currentWord.phonetic || '点击播放读音'}}</text>
        <text class="audio-icon">播放</text>
      </view>
      <view class="translation" wx:if="{{showTranslation}}">{{currentWord.zh}}</view>
      <view class="example-box" wx:if="{{showTranslation}}">
        <view class="example-en">{{currentWord.exEn}}</view>
        <view class="example-zh">{{currentWord.exZh}}</view>
      </view>
    </view>

    <view class="action-footer">
      <button wx:if="{{!showTranslation}}" class="btn-think" bindtap="showAnswer">查看释义</button>
      <button wx:else class="btn-primary" bindtap="nextWord">下一个词</button>
    </view>
  </view>

  <view wx:if="{{step === 'quiz'}}" class="quiz-state">
    <view class="top-bar">
      <text class="progress-text">随堂测试 {{quizIndex + 1}} / {{wordList.length}}</text>
      <text class="progress-text">已答对 {{correctCount}}</text>
    </view>

    <view class="quiz-card">
      <view class="quiz-word">{{currentWord.word}}</view>
      <view class="phonetic-row" bindtap="playAudio">
        <text class="phonetic">{{currentWord.phonetic || '点击播放读音'}}</text>
        <text class="audio-icon">播放</text>
      </view>
    </view>

    <view class="options-list">
      <view
        class="option-item {{quizShowResult ? (index === currentWord.correctIdx ? 'correct' : (quizSelected === index ? 'wrong' : '')) : ''}}"
        wx:for="{{currentWord.options}}"
        wx:key="index"
        bindtap="selectOption"
        data-index="{{index}}"
      >
        {{item}}
      </view>
    </view>

    <view class="action-footer" wx:if="{{quizShowResult}}">
      <button class="btn-primary" bindtap="nextQuiz">{{quizIndex + 1 === wordList.length ? '查看结果' : '下一题'}}</button>
    </view>
  </view>

  <view wx:if="{{step === 'result'}}" class="result-state">
    <view class="result-card">
      <view class="result-title">本轮闯关完成</view>
      <view class="result-subtitle">结果会同步到成长档案和任务记录</view>
      <view class="result-grid">
        <view class="result-item">
          <text class="result-value">{{lastSessionSummary.totalCount}}</text>
          <text class="result-label">学习单词</text>
        </view>
        <view class="result-item">
          <text class="result-value">{{lastSessionSummary.accuracy}}%</text>
          <text class="result-label">正确率</text>
        </view>
        <view class="result-item">
          <text class="result-value">{{rewardPoints}}</text>
          <text class="result-label">获得积分</text>
        </view>
        <view class="result-item">
          <text class="result-value">{{durationSeconds}}s</text>
          <text class="result-label">本轮耗时</text>
        </view>
      </view>

      <view class="wrong-tip" wx:if="{{wrongWords.length > 0}}">
        本次有 {{wrongWords.length}} 个错词，会自动加入错词本方便复习。
      </view>
    </view>

    <view class="result-actions">
      <button class="btn-primary" bindtap="finishSession">保存成绩并返回</button>
      <button class="btn-secondary" bindtap="goToWrongbook" wx:if="{{wrongWords.length > 0}}">去看错词本</button>
    </view>
  </view>
</view>
