page {
  background: #f5f7fb;
}

.quest-container {
  min-height: 100vh;
}

.dashboard-state {
  padding-bottom: 40rpx;
}

.hero {
  background: linear-gradient(160deg, #21344a, #375775);
  color: #fff;
  padding: 36rpx 30rpx 120rpx;
  border-radius: 0 0 36rpx 36rpx;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.82);
}

.hero-status {
  align-self: flex-start;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
}

.hero-status.done {
  background: rgba(145, 233, 181, 0.24);
  color: #ccffdb;
}

.hero-stats {
  display: flex;
  justify-content: space-between;
  margin-top: 40rpx;
}

.hero-stat {
  width: 30%;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 24rpx;
  padding: 24rpx 18rpx;
}

.hero-num {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
}

.hero-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
}

.panel {
  margin: -72rpx 24rpx 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 18rpx 48rpx rgba(31, 52, 82, 0.08);
}

.summary-panel {
  margin-top: 0;
}

.panel-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #23384c;
}

.bank-switch {
  display: flex;
  margin-top: 22rpx;
  padding: 6rpx;
  background: #eef2f7;
  border-radius: 999rpx;
}

.switch-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 999rpx;
  color: #6d7e90;
  font-size: 26rpx;
}

.switch-btn.active {
  background: #fff;
  color: #21344a;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(33, 52, 74, 0.1);
}

.bank-card {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 26rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #f7fafc, #edf4ff);
}

.bank-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  background: #21344a;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 700;
  margin-right: 20rpx;
}

.bank-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #23384c;
}

.bank-progress {
  margin-top: 10rpx;
  color: #6d7e90;
  font-size: 24rpx;
}

.start-btn,
.btn-primary,
.btn-think,
.btn-secondary {
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.start-btn,
.btn-primary,
.btn-think {
  margin-top: 24rpx;
  background: #21344a;
  color: #fff;
}

.btn-secondary {
  margin-top: 20rpx;
  background: #fff;
  color: #21344a;
  border: 2rpx solid #d7e1ec;
}

.summary-grid,
.result-grid {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.summary-item,
.result-item {
  width: 31%;
  margin-top: 14rpx;
  padding: 24rpx 18rpx;
  border-radius: 22rpx;
  background: #f6f8fb;
}

.summary-value,
.result-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #23384c;
}

.summary-label,
.result-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #78889a;
}

.tool-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 24rpx;
}

.tool-card {
  width: 48%;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 28rpx rgba(31, 52, 82, 0.05);
}

.tool-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: 700;
}

.tool-icon.orange {
  background: #ff8a3d;
}

.tool-icon.red {
  background: #ff645e;
}

.tool-icon.blue {
  background: #458cff;
}

.tool-icon.green {
  background: #3eb779;
}

.tool-name {
  margin-top: 18rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #23384c;
}

.tool-desc {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7b8c9e;
}

.learn-state,
.quiz-state,
.result-state {
  min-height: 100vh;
  padding-bottom: env(safe-area-inset-bottom);
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 26rpx 0;
}

.progress-text {
  font-size: 24rpx;
  color: #6d7e90;
}

.close-btn {
  color: #21344a;
  font-size: 24rpx;
  font-weight: 600;
}

.word-card,
.quiz-card,
.result-card {
  margin: 22rpx 24rpx 0;
  padding: 30rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 16rpx 42rpx rgba(31, 52, 82, 0.06);
}

.word-img,
.word-placeholder {
  width: 100%;
  height: 320rpx;
  border-radius: 24rpx;
}

.word-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #f2f6fa, #e6edf5);
  color: #8ca0b4;
  font-size: 48rpx;
  letter-spacing: 6rpx;
}

.word-title,
.quiz-word {
  margin-top: 28rpx;
  text-align: center;
  font-size: 56rpx;
  font-weight: 700;
  color: #21344a;
}

.phonetic-row {
  margin: 20rpx auto 0;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #f1f5f9;
  display: inline-flex;
  align-items: center;
}

.phonetic {
  font-size: 26rpx;
  color: #56708a;
}

.audio-icon {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #21344a;
}

.translation {
  margin-top: 30rpx;
  text-align: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #1c9b66;
}

.example-box {
  margin-top: 26rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #f7fafc;
}

.example-en {
  font-size: 28rpx;
  color: #23384c;
  line-height: 1.6;
}

.example-zh {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #78889a;
}

.options-list {
  padding: 18rpx 24rpx 0;
}

.option-item {
  margin-top: 16rpx;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #fff;
  color: #23384c;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.option-item.correct {
  background: #e9f9f1;
  color: #1c9b66;
  border: 2rpx solid #9bddbc;
}

.option-item.wrong {
  background: #fff0ee;
  color: #d85045;
  border: 2rpx solid #f3b5ad;
}

.action-footer,
.result-actions {
  padding: 28rpx 24rpx 40rpx;
}

.result-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #23384c;
  text-align: center;
}

.result-subtitle {
  margin-top: 14rpx;
  text-align: center;
  font-size: 24rpx;
  color: #78889a;
}

.wrong-tip {
  margin-top: 22rpx;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #fff5ef;
  color: #bd6042;
  font-size: 24rpx;
  line-height: 1.6;
}
