page { background-color: #f4f6f9; font-family: -apple-system, sans-serif; }
.quest-container { width: 100vw; min-height: 100vh; }

/* ================= 1. 大厅看板 ================= */
.header-board { background: linear-gradient(135deg, #512da8, #673AB7); padding: 60rpx 40rpx 80rpx; color: #fff; border-radius: 0 0 40rpx 40rpx; }
.user-greeting { font-size: 34rpx; font-weight: bold; margin-bottom: 40rpx; }
.stats-row { display: flex; justify-content: space-around; }
.stat-box { display: flex; flex-direction: column; align-items: center; }
.stat-box .num { font-size: 56rpx; font-weight: 900; }
.stat-box .label { font-size: 24rpx; opacity: 0.8; }

.task-card { background: #fff; border-radius: 30rpx; padding: 40rpx; margin: -40rpx 30rpx 0; box-shadow: 0 10rpx 30rpx rgba(103,58,183,0.1); position: relative; z-index: 10; }
.book-info { display: flex; align-items: center; margin-bottom: 40rpx; border-bottom: 2rpx solid #f0f0f0; padding-bottom: 30rpx; }
.book-cover { font-size: 80rpx; margin-right: 20rpx; }
.book-name { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 10rpx; }
.book-progress { font-size: 24rpx; color: #999; }
.daily-goal { font-size: 28rpx; color: #666; text-align: center; margin-bottom: 30rpx; }
.start-btn { background: #673AB7; color: #fff; border-radius: 50rpx; height: 100rpx; line-height: 100rpx; font-size: 34rpx; font-weight: bold; }

.tools-grid { display: flex; justify-content: space-between; padding: 50rpx 40rpx; }
.tool-item { background: #fff; width: 30%; padding: 30rpx 0; border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.03); }
.tool-icon { font-size: 48rpx; margin-bottom: 10rpx; }
.tool-item text { font-size: 26rpx; color: #555; font-weight: bold; }

/* ================= 通用顶栏 ================= */
.top-bar { display: flex; justify-content: space-between; align-items: center; padding: 30rpx 40rpx; }
.progress-text { font-size: 28rpx; color: #999; font-weight: bold; }
.close-btn { font-size: 48rpx; color: #999; line-height: 1; }

/* ================= 2. 认词模式 ================= */
.learn-state { height: 100vh; display: flex; flex-direction: column; background: #fff; }
.word-card { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 0 40rpx; }
.word-img { width: 100%; height: 350rpx; border-radius: 30rpx; margin-bottom: 40rpx; background: #eee; }
.word-title { font-size: 72rpx; font-weight: 900; color: #333; margin-bottom: 20rpx; }
.phonetic-row { display: inline-flex; align-items: center; background: #f3e5f5; padding: 10rpx 30rpx; border-radius: 40rpx; margin-bottom: 40rpx;}
.phonetic { font-size: 32rpx; color: #673AB7; font-family: monospace; margin-right: 16rpx; }
.translation { font-size: 40rpx; font-weight: bold; color: #2e7d32; margin-bottom: 30rpx; animation: fadeIn 0.3s;}
.example-box { width: 100%; background: #f9f9f9; padding: 30rpx; border-radius: 20rpx; animation: fadeIn 0.3s;}
.ex-en { font-size: 30rpx; color: #333; font-weight: bold; margin-bottom: 10rpx; }
.ex-zh { font-size: 26rpx; color: #666; }

.action-footer { padding: 40rpx; display: flex; justify-content: space-between; gap: 30rpx; padding-bottom: env(safe-area-inset-bottom); }
.btn-think { flex: 1; background: #673AB7; color: #fff; border-radius: 50rpx; height: 100rpx; line-height: 100rpx; font-weight: bold; }
.btn-red { flex: 1; background: #ffebee; color: #f44336; border: 2rpx solid #f44336; border-radius: 50rpx; height: 100rpx; line-height: 100rpx; font-weight: bold; }
.btn-green { flex: 1; background: #4caf50; color: #fff; border-radius: 50rpx; height: 100rpx; line-height: 100rpx; font-weight: bold; }

/* ================= 3. 测试模式 ================= */
.quiz-state { height: 100vh; display: flex; flex-direction: column; background: #f4f6f9; }
.quiz-card { padding: 60rpx 40rpx; text-align: center; }
.quiz-word { font-size: 64rpx; font-weight: 900; margin-bottom: 20rpx; color: #333; }
.options-list { padding: 0 40rpx; flex: 1; display: flex; flex-direction: column; gap: 24rpx; }
.option-item { background: #fff; padding: 40rpx; border-radius: 24rpx; font-size: 32rpx; font-weight: bold; color: #444; border: 4rpx solid transparent; text-align: center; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02); }
.option-item.correct { background: #e8f5e9; border-color: #4caf50; color: #2e7d32; }
.option-item.wrong { background: #ffebee; border-color: #f44336; color: #c62828; }
.btn-primary { width: 100%; background: #673AB7; color: #fff; border-radius: 50rpx; height: 100rpx; line-height: 100rpx; font-weight: bold; box-shadow: 0 8rpx 20rpx rgba(103,58,183,0.3); }

/* ================= 4. 结算模式 ================= */
.result-state { height: 100vh; background: #673AB7; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40rpx; }
.result-card { background: #fff; width: 100%; border-radius: 40rpx; padding: 80rpx 40rpx; text-align: center; margin-bottom: 60rpx; box-shadow: 0 20rpx 50rpx rgba(0,0,0,0.2); }
.result-icon { font-size: 120rpx; margin-bottom: 20rpx; }
.result-title { font-size: 48rpx; font-weight: 900; color: #333; margin-bottom: 60rpx; }
.stats-grid { display: flex; justify-content: space-around; border-top: 2rpx solid #eee; padding-top: 40rpx; }
.stat-item { display: flex; flex-direction: column; align-items: center; }
.s-val { font-size: 48rpx; font-weight: bold; color: #673AB7; margin-bottom: 10rpx; }
.s-label { font-size: 26rpx; color: #999; }
.btn-group { width: 100%; }

@keyframes fadeIn { from { opacity: 0; transform: translateY(10rpx); } to { opacity: 1; transform: translateY(0); } }
/* ================= 5. 词库切换器样式 ================= */
.bank-switch {
  display: flex;
  background: #f0f0f0;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 30rpx;
}
.switch-btn {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 16rpx 0;
  border-radius: 8rpx;
  font-weight: bold;
}
.switch-btn.active {
  background: #fff;
  color: #673AB7;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.05);
}