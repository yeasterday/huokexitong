page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #23384c;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #78889a;
  line-height: 1.6;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.filter-chip {
  margin-right: 12rpx;
  margin-top: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #eaf0f6;
  color: #667b90;
  font-size: 22rpx;
}

.filter-chip.active {
  background: #21344a;
  color: #fff;
}

.state-box,
.empty-box {
  margin-top: 22rpx;
  padding: 46rpx 30rpx;
  border-radius: 28rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #23384c;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #78889a;
}

.primary-btn {
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #21344a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.list {
  margin-top: 20rpx;
}

.resource-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.card-head,
.card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.type-tag,
.time-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.type-tag {
  background: #eef4fb;
  color: #447be5;
}

.time-tag {
  background: #f5f7fb;
  color: #667b90;
}

.resource-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #23384c;
}

.resource-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f7488;
}

.card-foot {
  margin-top: 18rpx;
}

.org-text {
  font-size: 22rpx;
  color: #7c8d9f;
}

.copy-btn {
  padding: 14rpx 20rpx;
  border-radius: 999rpx;
  background: #21344a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}
