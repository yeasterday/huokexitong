page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding-bottom: 100rpx;
}

.hero {
  padding: 32rpx 24rpx 28rpx;
  background: linear-gradient(160deg, #21344a, #375775);
  border-radius: 0 0 36rpx 36rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.8);
}

.search-box {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding: 0 10rpx 0 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
}

.search-input {
  flex: 1;
  height: 82rpx;
  color: #fff;
  font-size: 26rpx;
}

.search-action {
  padding: 18rpx 22rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #21344a;
  font-size: 24rpx;
  font-weight: 600;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.filter-chip {
  margin-right: 12rpx;
  margin-top: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
}

.filter-chip.active {
  background: #fff;
  color: #21344a;
}

.list {
  padding: 20rpx 24rpx 0;
}

.resource-card {
  margin-top: 16rpx;
  padding: 26rpx 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.card-head,
.resource-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.type-tag,
.points-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.type-tag {
  background: #eef4fb;
  color: #447be5;
}

.points-tag {
  background: #fff2eb;
  color: #e57737;
}

.resource-title {
  margin-top: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #23384c;
  line-height: 1.5;
}

.resource-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f7488;
}

.resource-foot {
  margin-top: 20rpx;
}

.resource-org {
  font-size: 22rpx;
  color: #7c8d9f;
}

.unlock-btn {
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #21344a;
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.state-box {
  margin-top: 18rpx;
  padding: 26rpx 0;
  text-align: center;
  color: #7c8d9f;
  font-size: 24rpx;
}

.fab-btn {
  position: fixed;
  right: 26rpx;
  bottom: 34rpx;
  width: 96rpx;
  height: 96rpx;
  border-radius: 999rpx;
  background: #ff8a3d;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 14rpx 30rpx rgba(255, 138, 61, 0.32);
}
