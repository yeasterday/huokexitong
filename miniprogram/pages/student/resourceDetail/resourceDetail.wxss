page { background-color: #f4f6f9; font-family: -apple-system, sans-serif; }
.resource-container { min-height: 100vh; padding-bottom: 40rpx; }

/* 顶部搜索区 */
.search-header { background: #673AB7; padding: 20rpx 30rpx 50rpx; border-radius: 0 0 40rpx 40rpx; }
.search-box { background: #fff; height: 80rpx; border-radius: 40rpx; display: flex; align-items: center; padding: 0 30rpx; box-shadow: 0 8rpx 20rpx rgba(103,58,183,0.2); }
.search-input { flex: 1; margin-left: 16rpx; font-size: 28rpx; color: #333; }
.clear-icon { padding: 10rpx; }

/* 列表区 */
.list-section { padding: 30rpx; margin-top: -30rpx; position: relative; z-index: 10; }
.resource-card { background: #fff; border-radius: 24rpx; padding: 40rpx 30rpx; margin-bottom: 30rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }
.card-tags { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.tag-official { font-size: 24rpx; color: #1976d2; font-weight: bold; }
.diamond { margin-right: 8rpx; }
.tag-category { background: #f3e5f5; color: #673AB7; font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 20rpx; font-weight: bold; }

.card-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 30rpx; line-height: 1.5; }

.card-bottom { display: flex; justify-content: space-between; align-items: center; }
.hot-stats { font-size: 24rpx; color: #ff9800; font-weight: bold; }
.download-btn { background: #673AB7; color: #fff; font-size: 26rpx; font-weight: bold; padding: 14rpx 30rpx; border-radius: 40rpx; box-shadow: 0 6rpx 12rpx rgba(103,58,183,0.2); }

.empty-tip { text-align: center; color: #999; font-size: 28rpx; padding-top: 100rpx; }

/* 悬浮发布按钮 (换成了橙色以区分首页的紫色发布按钮) */
.fab-btn { position: fixed; right: 40rpx; bottom: 100rpx; width: 110rpx; height: 110rpx; background: linear-gradient(135deg, #FFA726, #FF7043); border-radius: 55rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; box-shadow: 0 10rpx 20rpx rgba(255,112,67,0.3); }
.fab-icon { color: #fff; font-size: 48rpx; font-weight: 300; line-height: 50rpx; }
.fab-text { color: #fff; font-size: 20rpx; font-weight: bold; margin-top: -4rpx; }