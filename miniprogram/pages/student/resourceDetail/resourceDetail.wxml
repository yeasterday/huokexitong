<view class="page">
  <view class="hero">
    <view class="hero-title">资料中心</view>
    <view class="hero-subtitle">把政策、课程视频和学习资料集中到一个入口里。</view>

    <view class="search-box">
      <input class="search-input" placeholder="搜索资料标题、类型或内容" value="{{keyword}}" bindinput="handleInput" confirm-type="search" bindconfirm="onSearch" />
      <view class="search-action" bindtap="onSearch">搜索</view>
    </view>

    <view class="filter-row">
      <view class="filter-chip {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="changeFilter">全部</view>
      <view class="filter-chip {{filter === 'policy' ? 'active' : ''}}" data-filter="policy" bindtap="changeFilter">政策</view>
      <view class="filter-chip {{filter === 'video' ? 'active' : ''}}" data-filter="video" bindtap="changeFilter">视频</view>
      <view class="filter-chip {{filter === 'material' ? 'active' : ''}}" data-filter="material" bindtap="changeFilter">资料</view>
    </view>
  </view>

  <view class="list">
    <view class="resource-card" wx:for="{{resourceList}}" wx:key="_id">
      <view class="card-head">
        <view class="type-tag">{{item.type || '学习资料'}}</view>
        <view class="points-tag">{{item.points || 10}} 积分</view>
      </view>
      <view class="resource-title">{{item.title}}</view>
      <view class="resource-desc">{{item.content || '教师已发布可解锁内容，兑换后会自动进入我的资料。'}}</view>
      <view class="resource-foot">
        <text class="resource-org">{{item.orgName || item.authorName || '课程中心'}}</text>
        <view class="unlock-btn" bindtap="handleDownload" data-item="{{item}}">立即解锁</view>
      </view>
    </view>

    <view class="state-box" wx:if="{{!loading && resourceList.length === 0}}">暂时没有符合条件的资料</view>
    <view class="state-box" wx:if="{{loading}}">正在加载资源...</view>
    <view class="state-box" wx:if="{{!loading && resourceList.length > 0 && !hasMore}}">已经到底了</view>
  </view>

  <view class="fab-btn" wx:if="{{canPublish}}" bindtap="goToPublishResource">发布</view>
</view>
