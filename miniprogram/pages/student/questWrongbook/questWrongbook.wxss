page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #23384c;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #78889a;
}

.toolbar {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.search-box {
  border-radius: 999rpx;
  background: #f4f7fb;
  padding: 0 24rpx;
}

.search-input {
  height: 82rpx;
  font-size: 26rpx;
}

.filter-row {
  display: flex;
  margin-top: 18rpx;
}

.filter-chip {
  margin-right: 14rpx;
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  background: #eaf0f6;
  color: #667b90;
  font-size: 24rpx;
}

.filter-chip.active {
  background: #21344a;
  color: #fff;
}

.state-box,
.empty-box {
  margin-top: 22rpx;
  padding: 46rpx 30rpx;
  border-radius: 28rpx;
  text-align: center;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #23384c;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #78889a;
}

.primary-btn {
  margin-top: 22rpx;
  border-radius: 999rpx;
  background: #21344a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

.list {
  margin-top: 20rpx;
}

.word-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.word-head,
.word-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
}

.word-text {
  font-size: 34rpx;
  font-weight: 700;
  color: #23384c;
}

.phonetic {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #6b7f93;
}

.count-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #fff1ef;
  color: #d85045;
  font-size: 22rpx;
}

.word-meaning {
  margin-top: 18rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #3c5166;
}

.example-box {
  margin-top: 18rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #f7fafc;
}

.example-en {
  font-size: 24rpx;
  line-height: 1.6;
  color: #23384c;
}

.example-zh {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #78889a;
}

.word-foot {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #eef2f6;
}

.time-text {
  font-size: 22rpx;
  color: #7c8d9f;
}

.action-group {
  display: flex;
}

.ghost-btn,
.danger-btn {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.ghost-btn {
  background: #edf4ff;
  color: #447be5;
  margin-right: 12rpx;
}

.danger-btn {
  background: #fff1ef;
  color: #d85045;
}
