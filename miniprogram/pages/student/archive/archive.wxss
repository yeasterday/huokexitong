page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
}

.hero-card,
.card {
  padding: 26rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.card {
  margin-top: 20rpx;
}

.hero-title,
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #23384c;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #7c8d9f;
  line-height: 1.7;
}

.progress-row {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
}

.progress-bar {
  flex: 1;
  height: 18rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: #edf2f7;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #447be5, #5ac6ac);
}

.progress-num {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #23384c;
  font-weight: 600;
}

.stats-row {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}

.stat-item {
  width: 31%;
  padding: 20rpx 16rpx;
  border-radius: 22rpx;
  background: #f5f7fb;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #23384c;
}

.stat-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7c8d9f;
}

.readonly-row,
.field-item {
  margin-top: 22rpx;
}

.readonly-label,
.field-label {
  display: block;
  font-size: 24rpx;
  color: #6d8297;
}

.readonly-value {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #23384c;
}

.field-input,
.field-textarea {
  width: 100%;
  margin-top: 12rpx;
  border-radius: 20rpx;
  background: #f5f7fb;
  padding: 0 20rpx;
  font-size: 26rpx;
  color: #23384c;
  box-sizing: border-box;
}

.field-input {
  height: 84rpx;
}

.field-textarea {
  height: 180rpx;
  padding: 18rpx 20rpx;
}

.footer-action {
  margin-top: 22rpx;
}

.save-btn {
  border-radius: 999rpx;
  background: #21344a;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
