page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #23384c;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #78889a;
  line-height: 1.6;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.filter-chip {
  margin-right: 12rpx;
  margin-top: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #eaf0f6;
  color: #667b90;
  font-size: 22rpx;
}

.filter-chip.active {
  background: #21344a;
  color: #fff;
}

.state-box,
.empty-box {
  margin-top: 22rpx;
  padding: 46rpx 30rpx;
  border-radius: 28rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #23384c;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #78889a;
}

.list {
  margin-top: 20rpx;
}

.order-card {
  margin-top: 16rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.card-head {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
}

.order-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #23384c;
}

.order-time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7c8d9f;
}

.status-tag {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  height: fit-content;
}

.status-tag.pending {
  background: #fff2eb;
  color: #e57737;
}

.status-tag.shipped {
  background: #edf4ff;
  color: #447be5;
}

.status-tag.completed {
  background: #edf6f1;
  color: #2ea66f;
}

.metric-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.metric-pill {
  margin-right: 12rpx;
  margin-top: 10rpx;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  color: #5f7488;
  font-size: 22rpx;
}

.address-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 22rpx;
  background: #f7fafc;
}

.address-label {
  display: block;
  font-size: 22rpx;
  color: #7c8d9f;
}

.address-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #23384c;
}
