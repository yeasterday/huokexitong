<view class="page">
  <view class="hero">
    <view class="hero-title">学习日历</view>
    <view class="hero-subtitle">把签到和闯关都放在一个月视图里，方便你看连续性。</view>
  </view>

  <view class="summary-card">
    <view class="summary-item">
      <text class="summary-value">{{monthSummary.checkInDays}}</text>
      <text class="summary-label">本月签到天数</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{monthSummary.questDays}}</text>
      <text class="summary-label">本月闯关天数</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{monthSummary.totalSessions}}</text>
      <text class="summary-label">本月闯关场次</text>
    </view>
  </view>

  <view class="calendar-card">
    <view class="calendar-head">
      <view class="month-switch" data-direction="prev" bindtap="changeMonth">上一月</view>
      <view class="month-title">{{calendar.year}} 年 {{calendar.month}} 月</view>
      <view class="month-switch" data-direction="next" bindtap="changeMonth">下一月</view>
    </view>

    <view class="week-row">
      <text class="week-cell">日</text>
      <text class="week-cell">一</text>
      <text class="week-cell">二</text>
      <text class="week-cell">三</text>
      <text class="week-cell">四</text>
      <text class="week-cell">五</text>
      <text class="week-cell">六</text>
    </view>

    <view class="calendar-grid" wx:if="{{!loading}}">
      <view class="day-cell {{item.isToday ? 'today' : ''}} {{item.empty ? 'empty' : ''}}" wx:for="{{calendar.cells}}" wx:key="key">
        <block wx:if="{{!item.empty}}">
          <text class="day-num">{{item.day}}</text>
          <view class="marks">
            <view class="mark blue" wx:if="{{item.hasCheckIn}}">签</view>
            <view class="mark green" wx:if="{{item.hasQuest}}">关</view>
          </view>
          <text class="count" wx:if="{{item.count}}">{{item.count}}次</text>
        </block>
      </view>
    </view>

    <view class="loading-box" wx:if="{{loading}}">正在生成学习日历...</view>
  </view>

  <view class="legend-card">
    <view class="legend-item">
      <view class="legend-dot blue"></view>
      <text>已签到</text>
    </view>
    <view class="legend-item">
      <view class="legend-dot green"></view>
      <text>已闯关</text>
    </view>
  </view>
</view>
