page {
  background:
    linear-gradient(180deg, #f6f3ff 0%, #f6f8fc 24%, #f7f8fb 100%);
}

.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 46rpx;
  box-sizing: border-box;
}

.summary-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 34rpx 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #5f39b8 0%, #7b56d8 100%);
  color: #fff;
  box-shadow: 0 20rpx 48rpx rgba(103, 58, 183, 0.18);
}

.summary-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
}

.summary-subtitle {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.82;
  line-height: 1.7;
}

.summary-num {
  min-width: 120rpx;
  text-align: center;
}

.summary-value {
  display: block;
  font-size: 52rpx;
  font-weight: 900;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  opacity: 0.8;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 26rpx 0 20rpx;
  gap: 20rpx;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  gap: 16rpx;
}

.filter-chip {
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #fff;
  color: #767997;
  font-size: 24rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(31, 38, 135, 0.05);
}

.filter-chip.active {
  background: #5f39b8;
  color: #fff;
}

.toolbar-action {
  flex-shrink: 0;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(95, 57, 184, 0.08);
  color: #5f39b8;
  font-size: 24rpx;
  font-weight: 700;
}

.toolbar-action.disabled {
  opacity: 0.45;
}

.empty-state {
  margin-top: 120rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  color: #9095a8;
}

.empty-icon {
  font-size: 108rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4f5368;
}

.empty-desc {
  width: 80%;
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.8;
}

.message-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.message-card {
  display: flex;
  gap: 20rpx;
  padding: 26rpx;
  border-radius: 30rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 12rpx 28rpx rgba(31, 38, 135, 0.05);
}

.message-card.read {
  opacity: 0.9;
}

.message-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.message-avatar-img {
  width: 100%;
  height: 100%;
}

.message-avatar-text {
  font-size: 34rpx;
  font-weight: 700;
}

.message-main {
  flex: 1;
  min-width: 0;
}

.message-head {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
}

.message-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  flex-wrap: wrap;
}

.message-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #20233a;
}

.message-tag {
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.message-time {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #9aa0b5;
}

.message-action {
  display: block;
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #5c6177;
}

.message-body {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #2f3348;
  line-height: 1.7;
}

.message-quote {
  display: block;
  margin-top: 12rpx;
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #f5f6fb;
  color: #777d93;
  font-size: 24rpx;
  line-height: 1.7;
}

.message-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
}

.message-read {
  font-size: 22rpx;
  color: #ef5350;
  font-weight: 700;
}

.message-read.read {
  color: #9aa0b5;
}

.message-link {
  font-size: 22rpx;
  color: #5f39b8;
  font-weight: 700;
}

.load-more {
  text-align: center;
  padding: 26rpx 0 14rpx;
  color: #7c8197;
  font-size: 24rpx;
}

.load-more.done {
  color: #afb4c4;
}
