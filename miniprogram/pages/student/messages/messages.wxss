page { background: #f4f6f9; }
.container { padding: 30rpx; }
.empty-tip { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 60vh; color: #999; }
.empty-tip .icon { font-size: 100rpx; margin-bottom: 20rpx; }

.msg-item { background: #fff; padding: 30rpx; border-radius: 20rpx; display: flex; margin-bottom: 24rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03); }
.m-avatar { width: 90rpx; height: 90rpx; border-radius: 50%; margin-right: 24rpx; background: #eee; flex-shrink: 0;}
.m-content { flex: 1; }
.m-header { margin-bottom: 10rpx; }
.m-name { font-size: 30rpx; font-weight: bold; color: #673AB7; margin-right: 16rpx; }
.m-action { font-size: 26rpx; color: #666; }
.m-text { font-size: 30rpx; color: #333; margin-bottom: 16rpx; line-height: 1.4; }
.m-quote { font-size: 24rpx; color: #999; background: #f5f5f5; padding: 16rpx; border-radius: 12rpx; margin-bottom: 16rpx; }
.m-time { font-size: 22rpx; color: #ccc; }