page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
}

.hero {
  padding: 18rpx 6rpx 0;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #23384c;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #78889a;
  line-height: 1.6;
}

.summary-card {
  margin-top: 26rpx;
  padding: 26rpx 22rpx;
  border-radius: 28rpx;
  background: #fff;
  display: flex;
  justify-content: space-between;
  box-shadow: 0 14rpx 32rpx rgba(31, 52, 82, 0.06);
}

.summary-item {
  width: 31%;
}

.summary-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #23384c;
}

.summary-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7c8d9f;
}

.filter-row {
  display: flex;
  margin-top: 20rpx;
}

.filter-chip {
  margin-right: 16rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #eaf0f6;
  color: #667b90;
  font-size: 24rpx;
}

.filter-chip.active {
  background: #21344a;
  color: #fff;
}

.state-box,
.empty-box {
  margin-top: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  padding: 44rpx 30rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(31, 52, 82, 0.05);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #23384c;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #7c8d9f;
}

.list {
  margin-top: 22rpx;
}

.record-card {
  margin-top: 16rpx;
  padding: 26rpx 24rpx;
  border-radius: 26rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.card-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #23384c;
}

.card-time {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7c8d9f;
}

.card-score {
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #edf6f1;
  color: #1c9b66;
  font-size: 22rpx;
  height: fit-content;
}

.metric-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 18rpx;
}

.metric-pill {
  margin-right: 14rpx;
  margin-top: 12rpx;
  padding: 12rpx 18rpx;
  border-radius: 999rpx;
  background: #f5f7fb;
  color: #5d7288;
  font-size: 22rpx;
}

.word-preview {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #eef2f6;
  font-size: 22rpx;
  line-height: 1.6;
}

.word-preview-label {
  color: #7c8d9f;
}

.word-preview-text {
  color: #23384c;
}

.footer-action {
  margin-top: 22rpx;
}

.primary-btn,
.secondary-btn {
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.primary-btn {
  margin-top: 24rpx;
  background: #21344a;
  color: #fff;
}

.secondary-btn {
  background: #fff;
  color: #21344a;
  border: 2rpx solid #d7e1ec;
}
