<view class="page">
  <view class="hero">
    <view class="hero-title">闯关记录</view>
    <view class="hero-subtitle">每一轮学习都会沉淀成绩，方便你复盘最近的状态。</view>
  </view>

  <view class="summary-card">
    <view class="summary-item">
      <text class="summary-value">{{summary.sessions}}</text>
      <text class="summary-label">总场次</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{summary.learned}}</text>
      <text class="summary-label">累计学习词数</text>
    </view>
    <view class="summary-item">
      <text class="summary-value">{{summary.avgAccuracy}}%</text>
      <text class="summary-label">平均正确率</text>
    </view>
  </view>

  <view class="filter-row">
    <view class="filter-chip {{filter === 'all' ? 'active' : ''}}" data-filter="all" bindtap="changeFilter">全部</view>
    <view class="filter-chip {{filter === 'zhongkao' ? 'active' : ''}}" data-filter="zhongkao" bindtap="changeFilter">中考</view>
    <view class="filter-chip {{filter === 'gaokao' ? 'active' : ''}}" data-filter="gaokao" bindtap="changeFilter">高考</view>
  </view>

  <view class="state-box" wx:if="{{loading}}">正在整理你的闯关记录...</view>

  <block wx:elif="{{records.length === 0}}">
    <view class="empty-box">
      <view class="empty-title">还没有闯关记录</view>
      <view class="empty-desc">先完成一轮词汇闯关，记录和错词本就会自动生成。</view>
      <button class="primary-btn" bindtap="goQuest">去闯关</button>
    </view>
  </block>

  <view class="list" wx:else>
    <view class="record-card" wx:for="{{records}}" wx:key="_id">
      <view class="card-head">
        <view>
          <view class="card-title">{{item.bankName}}</view>
          <view class="card-time">{{item.timeText}}</view>
        </view>
        <view class="card-score">+{{item.rewardPoints || 0}} 积分</view>
      </view>

      <view class="metric-row">
        <view class="metric-pill">学习 {{item.totalCount}} 词</view>
        <view class="metric-pill">正确率 {{item.accuracy}}%</view>
        <view class="metric-pill">耗时 {{item.durationText}}</view>
      </view>

      <view class="word-preview" wx:if="{{item.wrongWords && item.wrongWords.length > 0}}">
        <text class="word-preview-label">本轮错词：</text>
        <text class="word-preview-text">{{item.wrongWords[0].word}}{{item.wrongWords.length > 1 ? ' 等' : ''}}</text>
      </view>
    </view>
  </view>

  <view class="footer-action" wx:if="{{records.length > 0}}">
    <button class="secondary-btn" bindtap="goWrongbook">查看错词本</button>
  </view>
</view>
