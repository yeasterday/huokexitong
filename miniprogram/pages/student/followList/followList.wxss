page { background: #f4f6f9; padding: 30rpx; }
.empty-tip { text-align: center; color: #999; margin-top: 100rpx; }
.f-item { display: flex; align-items: center; background: #fff; padding: 30rpx; border-radius: 20rpx; margin-bottom: 20rpx; box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.02); }
.f-avatar { width: 100rpx; height: 100rpx; border-radius: 50%; margin-right: 30rpx; }
.f-name { flex: 1; font-size: 32rpx; font-weight: bold; color: #333; }
.arrow { color: #ccc; font-weight: bold; }