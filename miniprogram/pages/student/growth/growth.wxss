page {
  background: #f5f7fb;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #23384c;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #78889a;
}

.summary-card {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #fff;
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.summary-item {
  width: 48%;
  margin-top: 10rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  background: #f5f7fb;
}

.summary-value {
  display: block;
  font-size: 34rpx;
  font-weight: 700;
  color: #23384c;
}

.summary-label {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #7c8d9f;
}

.state-box,
.empty-box {
  margin-top: 22rpx;
  padding: 46rpx 28rpx;
  border-radius: 28rpx;
  background: #fff;
  text-align: center;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #23384c;
}

.empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #78889a;
}

.timeline {
  margin-top: 22rpx;
}

.timeline-item {
  position: relative;
  padding-left: 34rpx;
  margin-bottom: 18rpx;
}

.timeline-item::before {
  content: '';
  position: absolute;
  left: 11rpx;
  top: 26rpx;
  bottom: -18rpx;
  width: 2rpx;
  background: #d8e0ea;
}

.timeline-item:last-child::before {
  display: none;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 18rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
}

.timeline-dot.checkin {
  background: #447be5;
}

.timeline-dot.quest {
  background: #2ea66f;
}

.timeline-dot.order {
  background: #ff8a3d;
}

.timeline-dot.resource {
  background: #8c5ce6;
}

.timeline-dot.moment {
  background: #d85045;
}

.timeline-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 12rpx 30rpx rgba(31, 52, 82, 0.05);
}

.timeline-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #23384c;
}

.timeline-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #5f7488;
}

.timeline-time {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #7c8d9f;
}
